# Environment variable template for the automation framework.
#
# Copy to .env and source before running, or export the variables in
# the operator's systemd unit (Phase 7). Empty values disable
# overrides; the framework's built-in defaults apply.
#
# Per ADR-13, only declared keys are honored. New keys require a
# pyproject.toml + ADR-13 amendment.

# --- logging -----------------------------------------------------------

# Override the log level for the framework's stderr logger.
# Allowed: TRACE | DEBUG | INFO | WARN | ERROR. Default: INFO.
# AUTOMATION_LOG_LEVEL=INFO

# --- adb ---------------------------------------------------------------

# Path to the `adb` binary. Default: `adb` (resolved via $PATH).
# AUTOMATION_ADB_BINARY=/usr/lib/android-sdk/platform-tools/adb

# Default subprocess timeout (seconds) for adb commands. Default: 10.0.
# AUTOMATION_ADB_DEFAULT_TIMEOUT=10.0

# --- bootstrap --------------------------------------------------------

# When set to "1", `python -m automation.bootstrap` will proceed even
# if the device's USB link speed cannot be read from sysfs (does NOT
# bypass a verified-too-slow link; that always fails). Same as the
# CLI flag --allow-unverified-usb. Default: "0".
# AUTOMATION_ALLOW_UNVERIFIED_USB=0
